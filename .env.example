# Продовый шаблон. Скопируй на сервере в .env и заполни:
#   cp .env.example .env && nano .env
# .env в gitignore - его никогда не будет в репозитории.

# --- Обязательно ---
# Сгенерируй свой ключ:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=0

# Кто может обращаться к сайту
ALLOWED_HOSTS=simpleprj.sbs,www.simpleprj.sbs

# Откуда приходят формы (csrf) - нужно для админки и логина по https
CSRF_TRUSTED_ORIGINS=https://simpleprj.sbs,https://www.simpleprj.sbs

# --- HTTPS (после выпуска сертификата certbot оставь =1) ---
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
# Включи =1 только когда https уже точно работает (иначе будет цикл редиректов)
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0

# --- Логи ---
DJANGO_LOG_LEVEL=INFO

# --- Email (по умолчанию письма печатаются в консоль) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=webmaster@localhost
